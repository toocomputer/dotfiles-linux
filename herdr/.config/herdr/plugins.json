[
  {
    "plugin_id": "custom.pane-namer",
    "name": "Pane Namer",
    "version": "0.1.0",
    "min_herdr_version": "0.7.5",
    "description": "Prompt for a pane name on split",
    "manifest_path": "/home/ee/dotfiles/herdr/.config/herdr/pane-namer/herdr-plugin.toml",
    "plugin_root": "/home/ee/dotfiles/herdr/.config/herdr/pane-namer",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "split-down-named",
        "title": "Split down (named)",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "open-prompt.sh",
          "down"
        ]
      },
      {
        "id": "split-right-named",
        "title": "Split right (named)",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "open-prompt.sh",
          "right"
        ]
      }
    ],
    "panes": [
      {
        "id": "prompt",
        "title": "New pane name",
        "placement": "popup",
        "width": 60,
        "height": 3,
        "command": [
          "sh",
          "prompt.sh"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]